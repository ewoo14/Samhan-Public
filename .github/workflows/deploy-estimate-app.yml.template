name: Deploy estimate-app v2 (template — 활성 X)

# clients/web/estimate-app v2 = Node.js + Express + EJS server-side rendering.
# Cloudflare Pages 는 정적 호스팅만 지원 → estimate-app v2 직접 배포 불가.
# 후보 호스팅:
#   1) 카페24 SSH (Node.js + pm2) — D6/D7/D8 답변 후 .template 제거 + activate
#   2) Cloudflare Workers (Express → workerd 변환 필요, 검토 후 결정)
#   3) Hetzner / Render.com Node.js 인스턴스 (Phase 7 backend 와 함께)
#
# 본 파일은 template — `.template` suffix 로 GitHub Actions 가 인식하지 않음.
# 호스팅 결정 후 `.template` 제거 + 아래 deploy step 교체로 활성화.

on:
  workflow_dispatch:
  # push 트리거는 호스팅 결정 후 활성:
  # push:
  #   branches: [main]
  #   paths:
  #     - 'clients/web/estimate-app/**'
  #     - '.github/workflows/deploy-estimate-app.yml'

permissions:
  contents: read

jobs:
  build:
    name: 빌드 검증 (배포 X)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    defaults:
      run:
        working-directory: clients/web/estimate-app

    steps:
      - name: 저장소 체크아웃
        uses: actions/checkout@v4

      - name: Node 20 설치
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: clients/web/estimate-app/package-lock.json

      - name: 의존성 설치
        run: npm ci

      - name: 단위 테스트
        run: npm test

