# estimate-app v2 환경변수
# 사용법: 본 파일 복사 -> .env 후 값 채움

# 서버 포트 (legacy Apps Script 진입 호환 — 5183 권장)
PORT=5183

# 사용자 이메일 (legacy Session.getActiveUser().getEmail() 대체 — dev only)
DEFAULT_USER_EMAIL=dev@samhan-air.com

# ─── Google Sheets 직접 read (개발책임자 결정 2026-05-05, 옵션 C) ─────────
# 견적서/주문서 품목 / 거래처 / 담당자 / 단가인상 / 추천실외기 등 시트 데이터는
# SamhanLogis backend 가 아닌 Google Sheets 직접 read.
#
# Service Account JSON 키 파일 절대 경로 (운영: /etc/samhan/sa-key.json)
GOOGLE_SERVICE_ACCOUNT_KEY=/etc/samhan/sa-key.json
# (옵션) JSON 키 전체를 base64 단일 문자열로 주입 — 컨테이너 환경 편의용
# GOOGLE_SA_KEY_JSON_BASE64=
# 시트 캐시 TTL 초 (기본 300 = 5분)
SHEET_CACHE_TTL_SEC=300
# legacy 견적 데이터 시트 ID (DECISIONS Phase 6 v4 참조)
SRC_SHEET_ID=1RJqO3jT-yJTi3NDBhL60o_cZWlVETGTU7UlvIKXuVNQ

# ─── SamhanLogis MS (slip 발송 + snapshot + 인증 + 감사로그) ──────────────
# slip-service 직접 호출 URL (견적 finalize → 출고전표 자동 생성)
# 실 운영: 동일한 gateway 통과; 개발: 직접 service URL 가능
SLIP_SERVICE_URL=http://localhost:8084

# SamhanLogis API gateway base URL (인증 / 감사로그 / snapshot)
SAMHAN_API_BASE_URL=http://localhost:8080

# partner-service (DC config 보강 — 시트 외 메타데이터)
PARTNER_SERVICE_URL=http://localhost:8082

# estimate-service (snapshot 임시저장 + history)
ESTIMATE_SERVICE_URL=http://localhost:8083

# audit-log endpoint (logFrontEvent 대체)
AUDIT_LOG_URL=http://localhost:8085/api/v1/audit-logs/front

# Mock fallback toggle — slip-service / 인증 endpoint 미구현시 메모리 mock 응답 (dev only)
USE_MOCK_FALLBACK=true
