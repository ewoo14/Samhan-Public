# estimate-app v2 환경변수
# 사용법: 본 파일 복사 -> .env 후 값 채움

# 서버 포트 (legacy Apps Script 진입 호환 — 5183 권장)
PORT=5183

# 사용자 이메일 (legacy Session.getActiveUser().getEmail() 대체 — dev only)
DEFAULT_USER_EMAIL=dev@samhan-air.com

# SamhanLogis API gateway base URL (모든 마이크로서비스 진입)
SAMHAN_API_BASE_URL=http://localhost:8080

# slip-service 직접 호출 URL (견적 finalize → 출고전표 자동 생성)
# 실 운영: 동일한 gateway 통과; 개발: 직접 service URL 가능
SLIP_SERVICE_URL=http://localhost:8084

# product-service (홈멀티/싱글/상업/구품목 카탈로그)
PRODUCT_SERVICE_URL=http://localhost:8081

# partner-service (거래처/담당자/DC config)
PARTNER_SERVICE_URL=http://localhost:8082

# estimate-service (snapshot 임시저장 + history)
ESTIMATE_SERVICE_URL=http://localhost:8083

# audit-log endpoint (logFrontEvent 대체)
AUDIT_LOG_URL=http://localhost:8085/api/v1/audit-logs/front

# Mock fallback toggle — endpoint 미구현시 메모리 mock 응답 (dev only)
USE_MOCK_FALLBACK=true
