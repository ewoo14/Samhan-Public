# slip-service 전용 환경변수 템플릿 (Slice B / notification-slice-B 후속).
#
# 이 파일은 slip-service 컨테이너 또는 systemd 유닛이 참조할 수 있는
# per-service env 템플릿입니다. infrastructure/.env.example 가 docker-compose
# 인프라 스택용이라면, 본 파일은 application 런타임 (bootRun / Docker / systemd)
# 전용으로 분리되어 있습니다.
#
# 사용법:
#   cp infrastructure/env-templates/slip-service.env services/slip-service/.env
#   (services/slip-service/.env 는 .gitignore 의 .env 패턴으로 자동 무시됨)
#
# 모든 값은 DEV-ONLY 기본값입니다. staging/prod 배포 시 안전한 값으로 교체.

# --- DataSource (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=slip_db
DB_USER=samhan
DB_PASSWORD=samhan_dev_pw

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# auth-service 와 user-service 의 /auth/internal/** 호출에 사용.
INTERNAL_AUTH_TOKEN=dev-internal-token-change-me

# --- Solapi SMS Gateway (Slice B) ---------------------------------------
# 출고 배송 기사 배치 단위 SMS 발송 (Plan §6).
# - H2 local 프로파일: MockSmsGateway 활성 → 아래 값 미사용 (logging only).
# - PgSQL (default) 프로파일: SolapiSmsGateway 활성 → 실 Solapi API 호출.
# - 사전 발신번호 등록 완료된 010 번호만 SOLAPI_SENDER_PHONE 으로 사용 가능.
# - 비용 추정: 기사 5~10명/일 × 배치 1~3건 = 월 1.5 ~ 4.5천원 (Plan §2 결정 N3).
# - 비용 모니터링: Phase 5 Notification Service 분리 시 Grafana 대시보드 추가
#   (현 Slice B 는 application log 기록만, deferred).
SOLAPI_API_KEY=dev-solapi-api-key-change-me
SOLAPI_API_SECRET=dev-solapi-api-secret-change-me
SOLAPI_SENDER_PHONE=01000000000
SOLAPI_BASE_URL=https://api.solapi.com
