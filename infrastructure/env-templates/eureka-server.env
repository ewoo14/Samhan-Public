# eureka-server 전용 환경변수 템플릿 (Phase 1).
#
# 단일 노드 = EUREKA_PEER_URL / EUREKA_INSTANCE_HOSTNAME 미사용.
# 다중 peer = peer1 + peer2 instance 두 개 띄울 때 사용.

# --- Eureka peer cluster -----------------------------------------------
EUREKA_PEER_URL=http://eureka-peer:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=eureka-peer1
