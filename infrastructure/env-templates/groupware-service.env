# groupware-service 전용 환경변수 템플릿 (Phase 9 W2).
# 모든 시크릿 값은 CHANGE_ME_LOCAL_ONLY placeholder — 실제 배포 시점에 secrets manager / .env 로 override.

# --- Server -------------------------------------------------------------
SAMHAN_GROUPWARE_PORT=8092

# --- DataSource (PostgreSQL) ---------------------------------------------
# Phase 8 2차 chained-default 패턴 — SAMHAN_GROUPWARE_DB_* 표준, LEGACY_DB_* legacy fallback (Phase 10 cutover 단일화).
SAMHAN_GROUPWARE_DB_HOST=localhost
SAMHAN_GROUPWARE_DB_PORT=5432
SAMHAN_GROUPWARE_DB_NAME=groupware_db
SAMHAN_GROUPWARE_DB_USER=CHANGE_ME_LOCAL_ONLY
SAMHAN_GROUPWARE_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준 (INTERNAL_AUTH_TOKEN legacy fallback 보존).
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY
INTERNAL_AUTH_TOKEN=CHANGE_ME_LOCAL_ONLY

# --- 외부 의존 service URL (UserClient) ----------------------------------
# user-service 의 /internal/users/{userId} lookup 호출에 사용.
SAMHAN_USER_SERVICE_URL=http://user-service:8083

# --- 외부 호출용 본 service URL (호출자가 사용) ----------------------------
# 형제 service (notification-service / dashboard-service) 가 groupware-service /internal/** 호출 시 사용.
SAMHAN_GROUPWARE_SERVICE_URL=http://groupware-service:8092

# --- Phase 8 2차 ServiceDiscoveryClient provider toggle ---------------------
# eureka (default) | aws-cloud-map (Phase 10 cutover 시점 활성)
SAMHAN_DISCOVERY_PROVIDER=eureka
