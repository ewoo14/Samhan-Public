# dc-config-service 전용 환경변수 템플릿 (Phase 6).

# --- DataSource (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dc_config_db
DB_USER=CHANGE_ME_LOCAL_ONLY
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준.
SAMHAN_INTERNAL_TOKEN=dev-only-token-replace
INTERNAL_AUTH_TOKEN=dev-only-token-replace
