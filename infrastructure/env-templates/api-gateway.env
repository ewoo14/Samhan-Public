# api-gateway 전용 환경변수 템플릿 (Phase 1).

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- JWT 서명 비밀키 ----------------------------------------------------
# Phase 8 2차 — SAMHAN_JWT_SECRET 표준 (JWT_SECRET legacy fallback 보존).
SAMHAN_JWT_SECRET=dev-secret-change-me-in-production-32bytes-min!
JWT_SECRET=dev-secret-change-me-in-production-32bytes-min!

# --- SSE / 장기 연결 응답 타임아웃 ---------------------------------------
# Phase 12 Step 1 (PR-H1) — slip-service 의 SSE realtime stream 보존용.
# Spring Cloud Gateway 의 Reactor Netty HttpClient 기본 response-timeout 은
# unset (무제한)이지만, 일부 인프라/middleware 가 짧은 timeout 을 강제할 수 있어
# 명시적으로 600s 로 설정 (heartbeat 30s × 다수 회 충분히 보존).
# 무제한이 필요하면 본 변수를 unset (주석처리) — Reactor Netty 기본값 적용.
# 단위: Duration string (ISO-8601 또는 Spring 약식). 600s = 10분.
SPRING_CLOUD_GATEWAY_HTTPCLIENT_RESPONSE_TIMEOUT=600s
