# dashboard-service 전용 환경변수 템플릿 (Phase 9 W4).
# 모든 시크릿 값은 CHANGE_ME_LOCAL_ONLY placeholder — 실제 배포 시점에 secrets manager / .env 로 override.

# --- Server -------------------------------------------------------------
SAMHAN_DASHBOARD_PORT=8094

# --- DataSource (PostgreSQL) ---------------------------------------------
# Phase 8 2차 chained-default 패턴 — SAMHAN_DASHBOARD_DB_* 표준, LEGACY_DB_* legacy fallback (Phase 10 cutover 단일화).
SAMHAN_DASHBOARD_DB_HOST=localhost
SAMHAN_DASHBOARD_DB_PORT=5432
SAMHAN_DASHBOARD_DB_NAME=dashboard_db
SAMHAN_DASHBOARD_DB_USER=CHANGE_ME_LOCAL_ONLY
SAMHAN_DASHBOARD_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준 (INTERNAL_AUTH_TOKEN legacy fallback 보존).
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY
INTERNAL_AUTH_TOKEN=CHANGE_ME_LOCAL_ONLY

# --- 외부 의존 service URL (4 client) ----------------------------------
# 4 client 의 기본 URL — Phase 10 cutover 시점에 service-discovery 기반 lookup 으로 전환.
SAMHAN_INVENTORY_SERVICE_URL=http://inventory-service:8085
SAMHAN_ACCOUNTING_SERVICE_URL=http://accounting-service:8087
SAMHAN_PARTNER_ORDER_SERVICE_URL=http://partner-order-service:8088
SAMHAN_PARTNER_SERVICE_URL=http://partner-service:8095

# --- 외부 호출용 본 service URL (호출자가 사용) ----------------------------
# 형제 service 가 dashboard-service /internal/** 호출 시 사용.
SAMHAN_DASHBOARD_SERVICE_URL=http://dashboard-service:8094

# --- Phase 8 2차 ServiceDiscoveryClient provider toggle ---------------------
# eureka (default) | aws-cloud-map (Phase 10 cutover 시점 활성)
SAMHAN_DISCOVERY_PROVIDER=eureka

# --- Phase 9 W4 — 캐시 토글 (D-P9-12, DevOps W3 backlog #4 채택) -----------
# caffeine (default, in-process) | redis (Phase 10 multi-instance scaling 시점 전환)
SAMHAN_CACHE_PROVIDER=caffeine
SAMHAN_DASHBOARD_KPI_CACHE_TTL=60
SAMHAN_DASHBOARD_KPI_CACHE_MAX=5000

# --- Phase 9 W4 — Materialized view REFRESH 주기 (D-P9-13) ----------------
# 분 단위 (default 5). 운영 부하 시 10 ~ 15 권장.
SAMHAN_DASHBOARD_REFRESH_INTERVAL=5
