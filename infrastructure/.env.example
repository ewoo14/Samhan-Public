# SamhanLogis - infrastructure environment template.
# Copy to ".env" only if you want to override compose defaults.
# All values below are DEV-ONLY. Never reuse in staging or production.

# --- PostgreSQL (DEV-ONLY) -----------------------------------------------
POSTGRES_USER=samhan
POSTGRES_PASSWORD=samhan_dev_pw
POSTGRES_DB=postgres

# --- RabbitMQ (DEV-ONLY) -------------------------------------------------
RABBITMQ_DEFAULT_USER=samhan
RABBITMQ_DEFAULT_PASS=samhan_dev_pw

# --- MinIO (DEV-ONLY) ----------------------------------------------------
MINIO_ROOT_USER=samhan
MINIO_ROOT_PASSWORD=samhan_dev_pw

# --- Elasticsearch (DEV-ONLY) --------------------------------------------
# Security disabled for local dev (xpack.security.enabled=false).
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Grafana (DEV-ONLY) --------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=samhan_dev_pw
GF_USERS_ALLOW_SIGN_UP=false
