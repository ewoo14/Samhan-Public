# 카페24 호스트 SSH 에서 ./.env 로 복사 후 실 시크릿 입력.
# chmod 600 .env 권장. git commit 절대 금지 — placeholder 만 추적.
#
# docker-compose.legacy-v2.yml 이 두 컨테이너 (estimate-legacy + order-legacy) 양쪽에
# 동일 .env 를 주입한다. 컨테이너별로 다른 값이 필요하면 각자 .env 분리 (env_file 변경).

# === server ===
NODE_ENV=production
DEFAULT_USER_EMAIL=ops@samhan-air.com
LOG_LEVEL=info

# === Google Sheets (Service Account) ===
# 옵션 1) JSON 키 파일 path — Docker host 의 절대 경로를 컨테이너 안으로 bind mount 하거나,
#         이미지 빌드 시 COPY (운영에서는 mount 권장)
GOOGLE_SERVICE_ACCOUNT_KEY=/etc/samhan/sa-key.json
# 옵션 2) JSON 전체를 base64 로 인코딩한 단일 문자열 (Linux: base64 -w0 sa.json)
# GOOGLE_SA_KEY_JSON_BASE64=__REPLACE_WITH_BASE64_ENCODED_SA_JSON__

# legacy 가 read 하는 단일 시트
SRC_SHEET_ID=1RJqO3jT-yJTi3NDBhL60o_cZWlVETGTU7UlvIKXuVNQ
SHEET_CACHE_TTL_SEC=300

# === e-Count proxy (legacy 152.69.228.109:3000 그대로) ===
ECOUNT_ENDPOINT=http://152.69.228.109:3000
ECOUNT_COM_CODE=__REPLACE__
ECOUNT_USER_ID=__REPLACE__
ECOUNT_API_CERT_KEY=__REPLACE__

# === Notion (legacy 4종 토큰 + DB ID) ===
NOTION_VERSION=2025-09-03
# DC config DB
NOTION_TOKEN_DC=__REPLACE_WITH_NOTION_SECRET__
NOTION_DB_ID_DC=193a1006d6588161a02cc8f196d7102b
# 주문 이력 DB
NOTION_TOKEN_ORDER=__REPLACE_WITH_NOTION_SECRET__
NOTION_DB_ID_ORDER=2eca1006d65880109d91c2e56fab28f4
# 거래처 인증 DB
NOTION_TOKEN_AUTH=__REPLACE_WITH_NOTION_SECRET__
NOTION_DB_ID_AUTH=2dda1006d6588047b1bbc7c2660203c0
# 스냅샷 / 로그 DB
NOTION_TOKEN_SNAPSHOT=__REPLACE_WITH_NOTION_SECRET__
NOTION_DB_ID_SNAPSHOT=33aa1006d6588087810ffaa7dc7f315c
# 견적 이력 / 발송 / 출고 / 로그 (legacy 부속 DB)
NOTION_TOKEN_QUOTE=__REPLACE_WITH_NOTION_SECRET__
NOTION_TOKEN_SEND=__REPLACE_WITH_NOTION_SECRET__
NOTION_TOKEN_SHIPPING=__REPLACE_WITH_NOTION_SECRET__
NOTION_TOKEN_LOG=__REPLACE_WITH_NOTION_SECRET__
